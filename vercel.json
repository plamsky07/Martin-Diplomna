{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install && cd grocery-shop && npm install",
  "devCommand": "cd grocery-shop && npm run dev -- --host 0.0.0.0 --port $PORT",
  "buildCommand": "cd grocery-shop && npm run build",
  "outputDirectory": "grocery-shop/dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
